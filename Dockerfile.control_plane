FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Every dependency in requirements.txt ships a wheel, so no compiler and no libpq headers are needed. A smaller image
# has less in it to patch.
COPY requirements.txt .
RUN pip install -r requirements.txt

COPY shared/ shared/
COPY control_plane/ control_plane/
COPY alembic/ alembic/
COPY alembic.ini .

# Run as a user that owns nothing but its own files. Kubernetes can then refuse to start the container as root
# (runAsNonRoot in the Helm chart).
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin shdp \
    && chown -R shdp /app
USER 10001

EXPOSE 8000

CMD ["uvicorn", "control_plane.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
