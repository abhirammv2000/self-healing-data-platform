DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<dbname>
DATABASE_URL_SYNC=postgresql://<user>:<password>@localhost:5432/<dbname>
REDIS_URL=redis://localhost:6379/0
ENV=dev # "production" also requires API_KEY_SECRET and ADMIN_SECRET_KEY to be 16+ characters and different
DATA_WAREHOUSE_URL=postgresql://<user>:<password>@localhost:5432/data_warehouse #local dev: separate Postgres DB used as the data warehouse
API_KEY_SECRET=<some_secret_value>
ADMIN_SECRET_KEY=<some_secret_value>
GOOGLE_API_KEY=<some_api_key>
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Local development only: let pipeline sources and webhooks point at localhost and other private addresses. Leave it
# false anywhere tenants are not trusted, see docs/PRODUCTION.md
ALLOW_PRIVATE_URLS=true

# optional, see docs/PRODUCTION.md: MAX_DOWNLOAD_MB, DIAGNOSTIC_TIMEOUT_SECONDS
# optional, see docs/RELIABILITY.md: RUN_LEASE_SECONDS, REAPER_INTERVAL_SECONDS, ENQUEUE_VISIBILITY_SECONDS, RUN_MAX_ATTEMPTS, SCHEDULER_INTERVAL_SECONDS, WORKER_METRICS_PORT
